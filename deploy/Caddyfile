# HTTPS for the API, with a certificate from Let's Encrypt (renewed automatically).
{$WINOU_DOMAIN} {
	encode zstd gzip

	# The app's APK, so testers install it from a link: https://<domain>/download/winou.apk
	handle_path /download/* {
		root * /srv/download
		file_server
	}

	# GitHub's push webhook for Jenkins (deploy/jenkins/). Only this path: the Jenkins UI stays on
	# the laptop at http://localhost:8081/jenkins.
	handle /jenkins/github-webhook* {
		reverse_proxy host.docker.internal:8081
	}

	handle {
		reverse_proxy api:8080
	}
}
