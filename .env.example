# Copy to .env and adjust. Never commit .env.

# --- ML service ---
ML_EMBED_MODEL=facebook/dinov2-base
ML_DEVICE=auto                    # auto | cpu | cuda
ML_MIN_DETECTION_CONFIDENCE=0.25
ML_CROP_MARGIN=0.10
ML_MAX_UPLOAD_MB=10
ML_MAX_IMAGE_PIXELS=40000000
ML_CROP_MAX_SIDE=1024

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pet_photos
EMBED_DIM=1536                    # must match the embedding model

# --- Backend (Spring Boot API + worker) ---
# Values below are for running the backend outside Docker; docker-compose overrides the service addresses.
DB_URL=jdbc:postgresql://localhost:5432/winou
DB_USER=winou
POSTGRES_PASSWORD=winou
JWT_SECRET=change-me-to-a-long-random-string   # at least 32 bytes: openssl rand -base64 48
JWT_EXPIRE_MINUTES=10080                       # 7 days
ML_SERVICE_URL=http://localhost:8000
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=winou
S3_SECRET_KEY=winou-dev-secret
S3_BUCKET=winou-photos
S3_SECURE=false
MAX_UPLOAD_MB=10
LOCATION_FUZZ_M=300               # public lost-report points are moved up to this far
LOCATION_FUZZ_SECRET=change-me-once-and-never-again   # same command as JWT_SECRET; changing it later leaks locations
MAP_MAX_RESULTS=500
RATE_LIMIT_LOST_REPORTS_PER_DAY=5
RATE_LIMIT_SIGHTINGS_PER_HOUR=20
RATE_LIMIT_PHOTOS_PER_HOUR=60
RATE_LIMIT_MESSAGES_PER_HOUR=60
RATE_LIMIT_REPORTS_PER_DAY=20     # "Report" button presses per user
STRAY_FADE_DAYS=30                # strays not seen or updated for this long leave the map
ASSOCIATION_ALERT_RADIUS_KM=10    # associations hear about injured animals this close
HIDE_AFTER_REPORTS=3              # reported by this many people: hidden until an admin reviews it
ADMIN_EMAILS=                     # comma-separated; these accounts get the Admin screen in the app

# --- Matching (values from research/RESULTS.md) ---
MATCH_THRESHOLD_DOG=0.60
MATCH_THRESHOLD_CAT=0.70
MATCH_RADIUS_KM=10
MATCH_LOST_WINDOW_DAYS=60         # new sighting: lost reports from the last N days
MATCH_SIGHTING_GRACE_DAYS=2       # new lost report: sightings from (lost date - N days)
MATCH_MAX_NOTIFICATIONS=3         # top matches notified per new photo

# --- Worker ---
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5             # then the photo is marked FAILED

# --- Push notifications ---
# Path to the Firebase service account key. docker-compose sets it for the worker
# (secrets/firebase-service-account.json); leave empty to only log matches.
FIREBASE_CREDENTIALS=
