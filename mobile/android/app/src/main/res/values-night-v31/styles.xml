<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash in dark mode (night outranks the API level when Android picks styles): the app icon on brand blue, then Flutter's animated splash -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
