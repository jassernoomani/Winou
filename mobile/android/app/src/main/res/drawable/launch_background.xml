<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: brand blue with the pin -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash" />

    <!-- The app's pin, the same as on Android 12+ and in the app's own launch screen -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_pin" />
    </item>
</layer-list>
